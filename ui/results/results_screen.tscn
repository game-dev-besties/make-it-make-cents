[sub_resource type="Shader" id="Shader_remove_white"]
code = "shader_type canvas_item;\nrender_mode unshaded;\n\nvoid fragment() {\n\tvec4 source = texture(TEXTURE, UV);\n\tfloat darkest = min(source.r, min(source.g, source.b));\n\tfloat lightest = max(source.r, max(source.g, source.b));\n\tfloat neutral = 1.0 - smoothstep(0.015, 0.09, lightest - darkest);\n\tfloat paper = smoothstep(0.94, 0.995, darkest) * neutral;\n\tsource.a *= 1.0 - paper;\n\tCOLOR = source;\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_face"]
shader = SubResource("Shader_remove_white")

