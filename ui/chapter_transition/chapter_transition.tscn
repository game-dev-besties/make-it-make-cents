[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/chapter_transition/chapter_transition.gd" id="1_script"]
[ext_resource type="FontFile" path="res://ui/theme/fonts/DepartureMono-Regular.ttf" id="2_font"]

[node name="ChapterTransition" type="CanvasLayer"]
unique_name_in_owner = true
visible = false
layer = 110
script = ExtResource("1_script")

[node name="BlackBackground" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0, 0, 0, 1)

[node name="TitleLabel" type="Label" parent="."]
unique_name_in_owner = true
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 48.0
offset_top = 48.0
offset_right = -48.0
offset_bottom = -48.0
