; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="legendary-disco"
run/main_scene="res://app/app.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"
GameStats="*res://game/runtime/game_state.gd"
PhraseMemory="*res://game/runtime/phrase_memory.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[dialogic]

directories/dch_directory={
"crush": "res://content/characters/crush/crush.dch",
"dad": "res://content/characters/dad/dad.dch",
"doctor": "res://content/characters/doctor/doctor.dch",
"grandma": "res://content/characters/grandma/grandma.dch",
"interviewer": "res://content/characters/interviewer/interviewer.dch",
"leo": "res://content/characters/leo/leo.dch",
"officer": "res://content/characters/officer/officer.dch",
"penny": "res://content/characters/penny/penny.dch",
"son": "res://content/characters/son/son.dch"
}
directories/dtl_directory={
"dad/dialogue": "res://content/episodes/dad/dialogue.dtl",
"dialogue": "res://content/episodes/intro/dialogue.dtl",
"grandma/dialogue": "res://content/episodes/grandma/dialogue.dtl",
"neighbors/dialogue": "res://content/episodes/neighbors/dialogue.dtl",
"son/dialogue": "res://content/episodes/son/dialogue.dtl"
}
layout/style_directory={
"": "res://ui/dialogue/dialogue_style.tres",
"Game Dialogue": "res://ui/dialogue/dialogue_style.tres"
}
extensions_folder="res://addons/legendary_dialogic"
history/simple_history_enabled=true
layout/default_style="res://ui/dialogue/dialogue_style.tres"
layout/style_list=Array[String](["res://ui/dialogue/dialogue_style.tres"])
text/autoskip_time_per_event=0.0

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[gui]

theme/custom="res://ui/theme/tooltip_theme.tres"

[importer_defaults]

animation_library={
&"animation/fps": 60.0
}

[input]

dialogic_default_action={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":16,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":true,"double_click":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":16,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":16,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":88,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
