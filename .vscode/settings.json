{
  "godot_tools.godot_path": "${workspaceFolder}/.bin/Godot.app",
  "godot_tools.editor_path": "${workspaceFolder}/.bin/Godot.app",
  "python.defaultInterpreterPath": "python3",
  "files.associations": {
    "*.md": "markdown",
    "*.dtl": "ini",
    "*.dch": "json",
    "*.phrases.json": "json"
  },
  "files.exclude": {
    "**/.godot": true,
    "**/*.import": true,
    "**/.git": false
  }
}
